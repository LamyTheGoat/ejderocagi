{
  "name": "ejder-ocagi-online",
  "version": "23.0.0",
  "description": "Ejder Ocağı Online — Node.js oyun sunucusu ve Firestore oyuncu ekonomisi",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:firestore": "node --test tests/firestore_store.integration.js",
    "test:trade-ui": "playwright test --config tests/playwright.config.js trade_ui",
    "test:ocak-sandigi": "playwright test --config tests/playwright.config.js ocak_sandigi",
    "test:layout": "playwright test --config tests/playwright.config.js eng09_layout",
    "test:eng10": "playwright test --config tests/playwright.config.js eng10_economy"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "private": true,
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0"
  },
  "overrides": {
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
